<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OctreeLod.Core\OctreeLod.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Sdk.Web defaults to Server GC (one heap + thread per core, tuned
         for many threads allocating in parallel) but ingestion here runs on
         a single thread — Workstation GC (OctreeLod.App's default, same
         SDK-less choice) fits that shape better. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

</Project>
